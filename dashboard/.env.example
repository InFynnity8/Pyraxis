# Copy to .env.local (never commit .env.local), fill in, then RESTART `npm run dev` (Next.js reads this only at startup).
# "Ask the data" tries providers in this order until one answers: Claude -> Groq -> Hugging Face -> search only.
# Fill in only the ones you have; leave the rest empty.

# Recommended (free tier): Groq. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a Groq chat model id (production models: openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Claude via the Anthropic API. A Claude Pro (claude.ai) subscription does NOT include API access;
# API keys and credits come from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Hugging Face Inference Providers (small free monthly allowance). Fine-grained token with
# "Make calls to Inference Providers": https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest

# Optional: set to "off" to force search-only mode (e.g. a demo with no network).
ASK_AI=
